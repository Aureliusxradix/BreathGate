<?xml version="1.0" encoding="utf-8"?>
<!-- The mark: rings opening from one centre — the breath, and the same rosette family as the
     guilloche. Adaptive-icon geometry, corrected 2026-08-14: the foreground canvas is 108×108
     and its guaranteed-visible safe zone is the centre 66dp, i.e. a circle of radius 33 about
     (54,54). The first version was centred at y=44 and topped out at r=38 — so it sat high AND
     spilled past the safe zone, which is exactly the "off centre and not filling the space"
     he saw. Now centred true and grown to the safe-zone edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#2E8B7A"
        android:pathData="M54,54 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    <path android:strokeColor="#3FB39C" android:strokeWidth="2.4" android:fillColor="#00000000"
        android:pathData="M54,54 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />
    <path android:strokeColor="#3FB39C" android:strokeWidth="2.0" android:strokeAlpha="0.74"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-25,0 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0" />
    <path android:strokeColor="#3FB39C" android:strokeWidth="1.6" android:strokeAlpha="0.48"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />
    <path android:strokeColor="#3FB39C" android:strokeWidth="1.3" android:strokeAlpha="0.26"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-33,0 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0" />
</vector>
